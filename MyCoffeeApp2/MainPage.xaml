<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:MyCoffeeApp2"
             xmlns:viewmodels="clr-namespace:MyCoffeeApp2"         
             x:Class="MyCoffeeApp2.MainPage"
             x:DataType="viewmodels:MyCoffeeViewModel"
             Title="My Coffee App 2">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}"/>
    </ContentPage.ToolbarItems>-->
    
    <VerticalStackLayout Margin="20">
        <Label Text="Hello"/>
        <HorizontalStackLayout>
            <Button Text="Add Coffee"
                    Command="{Binding AddCommand}"/>
            <Button Text="Get Coffee"
                    Command="{Binding RefreshCommand}"/>
        </HorizontalStackLayout>

        <CollectionView BackgroundColor="Transparent"
                        ItemsSource="{Binding Coffee}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Coffee">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItem Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MyCoffeeViewModel}}, Path=RemoveCommand}"
                                       CommandParameter="{Binding .}"
                                       IsDestructive="True"
                                       Text="Delete"
                                       BackgroundColor="red"/>
                        </SwipeView.RightItems>
                        <Grid Padding="0"
                              Margin="0, 10, 0, 10">
                            <Frame CornerRadius="20"
                                   HasShadow="True"
                                   Background="{StaticResource Secondary}">
                                <HorizontalStackLayout Spacing="20">
                                    <Image Source="{Binding Image}"
                                           WidthRequest="120"/>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="Large"
                                               VerticalOptions="End"/>
                                        <Label Text="{Binding Roaster}"
                                               FontSize="Large"
                                               VerticalOptions="End"/>
                                        <Label Text="{Binding Id}"
                                               FontSize="Small"
                                               VerticalOptions="End"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Frame>
                        </Grid>

                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    
    
</ContentPage>
