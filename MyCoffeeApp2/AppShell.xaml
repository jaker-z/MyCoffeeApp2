<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyCoffeeApp2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyCoffeeApp2"
    Title="MyCoffeeApp2">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Prompt"
        ContentTemplate="{DataTemplate local:CoffeePrompt}"
        Route="CoffeePrompt"/>

</Shell>
